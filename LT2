RunService.RenderStepped:Connect(function()
    -- Particles update
    if ParticlesActive then
        for _, p in pairs(ParticleList) do
            local pos = p.obj.Position; local newX, newY = pos.X.Scale + p.vel.X, pos.Y.Scale + p.vel.Y
            if newX > 1 or newX < 0 then p.vel = Vector2.new(-p.vel.X, p.vel.Y) end
            if newY > 1 or newY < 0 then p.vel = Vector2.new(p.vel.X, -p.vel.Y) end
            p.obj.Position = UDim2.new(newX, 0, newY, 0)
        end
    end

    -- Scroll canvas resizing
    for _, data in pairs(Pages) do 
        if data.Page then data.Page.CanvasSize = UDim2.new(0, 0, 0, data.Layout.AbsoluteContentSize.Y + 20) end 
    end
    SettingsOverlay.CanvasSize = UDim2.new(0, 0, 0, SettingsLayout.AbsoluteContentSize.Y + 20)
    TabHolder.CanvasSize = UDim2.new(0, 0, 0, TabListLayout.AbsoluteContentSize.Y + 10)

    -- Player modifications (Speed, Jump, Noclip)
    local char = LP.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if WalkSpeedState then humanoid.WalkSpeed = WalkSpeedVal end
            if JumpHeightState then humanoid.JumpPower = JumpHeightVal end
        end
        if NoclipState then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end

    -- Fixed Camera Freeze Loop
    if CameraFreezeState and LockedCameraCF then
        Camera.CFrame = LockedCameraCF
    elseif SpectatingState and SelectedPlayerName then
        local targetPlayer = Players:FindFirstChild(SelectedPlayerName)
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        end
    end

    -- ESP Loop Implementation (Highlight & Info)
    if EspState then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local pChar = p.Character
                local hrp = pChar.HumanoidRootPart
                local hum = pChar:FindFirstChildOfClass("Humanoid")
                
                -- Highlight Check
                local highlight = pChar:FindFirstChild("CipsHighlight")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "CipsHighlight"
                    highlight.Adornee = pChar
                    highlight.FillColor = Theme.Accent
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.Parent = pChar
                end
                
                -- Billboards / Info tags
                local billboard = pChar:FindFirstChild("CipsBillboard")
                if (EspName or EspHealth or EspDist) then
                    if not billboard then
                        billboard = Instance.new("BillboardGui")
                        billboard.Name = "CipsBillboard"
                        billboard.Size = UDim2.new(0, 200, 0, 50)
                        billboard.StudsOffset = Vector3.new(0, 3, 0)
                        billboard.AlwaysOnTop = true
                        
                        local textLabel = Instance.new("TextLabel", billboard)
                        textLabel.Name = "InfoText"
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.Font = Enum.Font.GothamBold
                        textLabel.TextSize = 12
                        textLabel.TextColor3 = Theme.Text
                        textLabel.TextStrokeTransparency = 0.5
                        
                        billboard.Parent = pChar
                    end
                    
                    local infoText = billboard:FindFirstChild("InfoText")
                    if infoText then
                        local infoString = ""
                        if EspName then infoString = infoString .. p.Name .. "\n" end
                        if EspHealth and hum then infoString = infoString .. "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. "\n" end
                        if EspDist and char and char:FindFirstChild("HumanoidRootPart") then
                            local dist = math.floor((hrp.Position - char.HumanoidRootPart.Position).Magnitude)
                            infoString = infoString .. "[" .. dist .. " studs]"
                        end
                        infoText.Text = infoString
                        billboard.Enabled = true
                    end
                else
                    if billboard then billboard.Enabled = false end
                end
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then
                local hl = p.Character:FindFirstChild("CipsHighlight")
                if hl then hl:Destroy() end
                local bb = p.Character:FindFirstChild("CipsBillboard")
                if bb then bb:Destroy() end
            end
        end
    end
end)

